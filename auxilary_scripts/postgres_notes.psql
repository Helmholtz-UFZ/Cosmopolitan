-- Local
CREATE USER somweb_stage_rw WITH PASSWORD '***';
CREATE DATABASE somweb_stage
GRANT CONNECT ON DATABASE somweb_stage TO somweb_stage_rw;
-- All
CREATE TABLE jobs (job_id VARCHAR PRIMARY KEY, start_date DATE, input_data JSONB, submitted BOOL, cluster_job_id VARCHAR, email VARCHAR, notified_end VARCHAR, logs VARCHAR, status VARCHAR, version DECIMAL);
CREATE TABLE logs (
    log_id SERIAL PRIMARY KEY,
    level VARCHAR(10),
    message VARCHAR,
    timestamp TIMESTAMPTZ
);
GRANT INSERT, UPDATE, DELETE ON TABLE jobs TO somweb_stage_rw;
-- Stuff
DROP TABLE IF EXISTS jobs;
DROP TABLE IF EXISTS logs;
SELECT * FROM jobs;
SELECT job_id, start_date FROM jobs;
SELECT job_id, status FROM jobs;
SELECT job_id, cluster_job_id FROM jobs;
